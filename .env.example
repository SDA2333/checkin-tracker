# ===== 签到清单 配置 =====

# 访问密码（单人登录用）。部署脚本会自动生成一个强随机密码，
# 你也可以直接改成自己好记的强密码，改完重启服务即可生效。
APP_PASSWORD=change-this-password

# 服务监听端口
PORT=3000
# 服务监听地址：公网直连用 0.0.0.0；Tailscale/内网访问可填 100.x.y.z 或 127.0.0.1
# HOST=0.0.0.0

# 数据库文件路径（默认 ./data/checkin.db）
# DB_PATH=./data/checkin.db

# 设为 true 可完全关闭登录（仅限可信内网环境，公网请勿开启）
# AUTH_DISABLED=false

# ===== 反向代理 / HTTPS（如 Cloudflare、Nginx、Caddy）=====
# 在反向代理后面时设为代理层数（通常为 1），使登录限速能识别真实客户端 IP
# TRUST_PROXY=1
# 走 HTTPS 时设为 true（Cookie 仅在加密连接下发送，更安全）。
# ⚠️ 纯 HTTP 访问时务必保持 false/留空，否则登录后 Cookie 不会被发送
# SECURE_COOKIE=true

# ===== 续期提醒推送 =====
# 提醒日期计算使用的时区；不设置时默认 Asia/Hong_Kong
# CHECKIN_TZ=Asia/Hong_Kong
# Bark 推送地址，形如 https://api.day.app/<your-key>。配置后 notify.py 会优先使用 Bark。
# CHECKIN_BARK_URL=
# 多设备可用逗号分隔：CHECKIN_BARK_URLS=https://api.day.app/iphoneKey,https://api.day.app/ipadKey
# CHECKIN_BARK_URLS=
# 可选：通知标题、副标题与图标；icon 需 iOS 15 或以上
# CHECKIN_BARK_TITLE=签到清单续期提醒
# CHECKIN_BARK_SUBTITLE=
# CHECKIN_BARK_ICON=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/google-calendar.png
# 可选：点通知后打开的网页地址
# CHECKIN_BARK_JUMP_URL=https://example.com/
# 可选：通知分组与级别
# CHECKIN_BARK_GROUP=签到清单
# CHECKIN_BARK_LEVEL=timeSensitive

# QQ/OpenClaw 旧通道，仅在未配置 Bark 时使用
# CHECKIN_QQ_TARGET=user:<openid>
