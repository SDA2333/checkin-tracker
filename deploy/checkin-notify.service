[Unit]
Description=签到清单 续期到期提醒
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
# 从 /opt/checkin/.env 读取 CHECKIN_BARK_URL / CHECKIN_BARK_JUMP_URL 等提醒配置。
# 未配置 Bark 时，可用 CHECKIN_QQ_TARGET 走旧 OpenClaw QQ 通道。
EnvironmentFile=-/opt/checkin/.env
ExecStart=/usr/bin/python3 /opt/checkin/notify.py
User=root
